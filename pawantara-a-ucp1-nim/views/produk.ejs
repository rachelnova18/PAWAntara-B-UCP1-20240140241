<%- include('partials/navbar') %>

<main class="container mx-auto px-4 py-8 flex-grow max-w-6xl">
    
    <!-- Hero Banner (Sesuai Gambar) -->
    <section class="bg-[#115c38] rounded-2xl p-6 md:p-10 flex flex-col md:flex-row items-center justify-between text-white mb-10 overflow-hidden relative shadow-lg">
        <div class="z-10 w-full md:w-1/2">
            <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-4">
                Get <span class="text-yellow-400">free delivery</span> on shopping Rp 200rb
            </h1>
            <p class="text-green-100 mb-6 text-sm md:text-base">Get the freshest groceries delivered right to your home. Save time, skip the lines, and enjoy quick delivery.</p>
            <button class="bg-yellow-400 text-green-900 font-bold py-2 px-6 rounded-md hover:bg-yellow-300 transition flex items-center gap-2">
                Learn More <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>
        </div>
        <!-- Ilustrasi Sayuran (Placeholder) -->
        <div class="z-10 mt-6 md:mt-0 md:absolute md:-right-10 md:top-0 h-full flex items-center">
            <img src="https://images.unsplash.com/photo-1542838132-92c53300491e?w=500&q=80" alt="Groceries" class="w-64 md:w-96 rounded-full object-cover border-4 border-green-700/50 shadow-2xl mix-blend-luminosity hover:mix-blend-normal transition duration-500">
        </div>
    </section>

    <!-- Header & Filter (Sesuai Gambar) -->
    <section class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
        <h2 class="text-2xl font-bold">All Products</h2>
        
        <form action="/produk" method="GET" class="flex flex-wrap gap-2 w-full md:w-auto">
            <!-- Search bar -->
            <input type="text" name="search" value="<%= search || '' %>" placeholder="Cari produk..." class="border border-gray-300 px-4 py-2 rounded-lg text-sm focus:outline-none focus:border-green-600 flex-grow md:flex-grow-0">
            
            <!-- Category Dropdown -->
            <select name="kategori" class="border border-gray-300 bg-white px-4 py-2 rounded-lg text-sm font-medium focus:outline-none focus:border-green-600" onchange="this.form.submit()">
                <option value="">All Categories ⌄</option>
                <option value="beras" <%= kategori === 'beras' ? 'selected' : '' %>>Beras</option>
                <option value="minyak" <%= kategori === 'minyak' ? 'selected' : '' %>>Minyak</option>
                <option value="gula" <%= kategori === 'gula' ? 'selected' : '' %>>Gula</option>
                <option value="telur" <%= kategori === 'telur' ? 'selected' : '' %>>Telur</option>
            </select>
        </form>
    </section>

    <!-- Product Grid -->
    <section>
        <% if (products.length === 0) { %>
            <div class="text-center py-10">
                <p class="text-gray-500 text-lg">Produk tidak ditemukan.</p>
                <a href="/produk" class="text-green-600 underline mt-2 block">Reset Filter</a>
            </div>
        <% } else { %>
            <!-- Grid: 2 kolom di HP, 4 kolom di Desktop -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
                <% products.forEach(p => { %>
                    <article class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition group flex flex-col relative">
                        
                        <!-- Badges (Kiri Kiri Atas) -->
                        <div class="absolute top-4 left-4 z-10 flex flex-col gap-1">
                            <% if (p.badge) { %>
                                <span class="bg-red-700 text-white text-[10px] font-bold px-2 py-1 rounded-sm uppercase tracking-wider"><%= p.badge %></span>
                            <% } %>
                        </div>

                        <!-- Image (Link ke detail) -->
                        <a href="/produk/<%= p.id %>" class="block h-32 md:h-40 w-full mb-4 overflow-hidden rounded-lg">
                            <img src="<%= p.image %>" alt="<%= p.name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                        </a>

                        <!-- Text Content -->
                        <a href="/produk/<%= p.id %>" class="flex-grow">
                            <h3 class="text-sm font-semibold text-gray-800 line-clamp-2 leading-tight mb-1"><%= p.name %></h3>
                            <p class="text-xs text-gray-400 capitalize"><%= p.category %> • Stok: <%= p.stock %></p>
                        </a>

                        <!-- Bottom Row: Price & Add Button -->
                        <div class="mt-4 flex justify-between items-center">
                            <p class="text-lg font-bold text-gray-900">Rp <%= (p.price / 1000).toLocaleString('id-ID') %><span class="text-xs text-gray-500 font-normal">K</span></p>
                            
                            <!-- Tombol (+) khas Tazaj Mart -->
                            <a href="/produk/<%= p.id %>" class="w-8 h-8 rounded-full bg-[#115c38] text-white flex justify-center items-center font-bold text-lg hover:bg-green-700 transition shadow-sm pb-1">
                                +
                            </a>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </section>
</main>

<%- include('partials/footer') %>