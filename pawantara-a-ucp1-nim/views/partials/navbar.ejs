<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Toko Sembako Ariesta</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Sembunyikan scrollbar untuk tampilan lebih bersih */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen font-sans">
    <header class="bg-white border-b sticky top-0 z-50 shadow-sm">
        <nav class="container mx-auto px-4 py-4 flex justify-between items-center relative">
            <!-- Logo -->
            <a href="/" class="text-2xl font-bold flex items-center gap-2">
                <span class="text-green-700">🛒 Toko</span>Ariesta
            </a>
            
            <!-- Hamburger Button -->
            <button id="menu-btn" class="md:hidden focus:outline-none text-gray-600" aria-label="Toggle Menu">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>

            <!-- Links -->
            <ul id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-white border-b md:border-none md:static md:w-auto md:flex md:gap-8 flex-col md:flex-row p-4 md:p-0 shadow-md md:shadow-none z-10 text-sm font-medium">
                <li><a href="/" class="<%= path === '/' ? 'text-green-700 font-bold' : 'text-gray-600 hover:text-green-700' %>">Beranda</a></li>
                <li><a href="/produk" class="<%= path === '/produk' ? 'text-green-700 font-bold' : 'text-gray-600 hover:text-green-700' %>">All Products</a></li>
                <li><a href="/tanya-ai" class="<%= path === '/tanya-ai' ? 'text-green-700 font-bold' : 'text-gray-600 hover:text-green-700' %>">Tanya AI</a></li>
            </ul>
        </nav>
    </header>

    <script>
        document.getElementById('menu-btn').addEventListener('click', function(e) {
            e.preventDefault();
            document.getElementById('mobile-menu').classList.toggle('hidden');
            document.getElementById('mobile-menu').classList.toggle('flex');
        });
    </script>