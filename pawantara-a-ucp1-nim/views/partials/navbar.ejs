<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Toko Sembako Ariesta - Maroon Elegance</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/maroon.css">
</head>
<body class="flex flex-col min-h-screen text-slate-800">
    <!-- Top Announcement Bar (Deep Maroon & Warm Gold) -->
    <div class="bg-[#4a0c1a] border-b border-[#631327] text-[11px] py-1.5 px-4 text-center text-amber-200 font-semibold tracking-wide shadow-xs">
        <span>✨ TOKO SEMBAKO ARIESTA • GRATIS ONGKIR MIN. BELANJA RP 200.000 • STOK TER-UPDATE REALTIME</span>
    </div>

    <!-- Header & Nav Bar (Clean Elegant Maroon) -->
    <header class="bg-white/95 backdrop-blur-md border-b border-[#eee7e0] sticky top-0 z-50 shadow-xs">
        <nav class="container mx-auto px-4 py-3.5 flex justify-between items-center relative max-w-7xl">
            
            <!-- Left: Logo -->
            <a href="/" class="text-xl md:text-2xl font-extrabold flex items-center gap-2.5 tracking-tight group">
                <span class="bg-[#75142c] text-amber-300 p-2 rounded-xl text-base shadow-sm group-hover:scale-105 transition duration-300">🛒</span>
                <span class="text-maroon-dark font-black text-xl md:text-2xl uppercase tracking-tight">Toko Ariesta</span>
            </a>

            <!-- Center: Navigation Links -->
            <ul id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-white border-b border-[#eee7e0] md:border-none md:static md:w-auto md:flex md:items-center md:gap-8 flex-col md:flex-row p-6 md:p-0 shadow-lg md:shadow-none z-50 text-xs uppercase font-extrabold tracking-wider text-slate-600">
                <li>
                    <a href="/" class="<%= path === '/' ? 'text-[#75142c] font-black py-1 border-b-2 border-[#75142c]' : 'hover:text-[#75142c] transition py-1' %>">Beranda</a>
                </li>
                <li>
                    <a href="/produk" class="<%= path === '/produk' ? 'text-[#75142c] font-black py-1 border-b-2 border-[#75142c]' : 'hover:text-[#75142c] transition py-1' %>">All Products</a>
                </li>
                <li>
                    <a href="/tanya-ai" class="<%= path === '/tanya-ai' ? 'text-[#75142c] font-black py-1 border-b-2 border-[#75142c]' : 'hover:text-[#75142c] transition py-1' %>">Tanya AI ✨</a>
                </li>
            </ul>

            <!-- Right: Search & Action Controls -->
            <div class="flex items-center gap-3">
                <a href="/produk" class="p-2 text-slate-600 hover:text-[#75142c] transition rounded-xl bg-slate-100/70 hover:bg-slate-200/80 border border-slate-200" title="Cari Produk">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </a>
                
                <% if (locals.isAdmin) { %>
                    <a href="/dashboard" class="<%= path === '/dashboard' ? 'maroon-btn' : 'bg-[#75142c]/10 text-[#75142c] hover:bg-[#75142c]/20 border border-[#75142c]/20' %> px-3.5 py-2 rounded-xl transition text-xs font-extrabold flex items-center gap-1.5 shadow-xs">
                        <span>⚙️ Dashboard</span>
                    </a>
                    <a href="/logout" class="text-red-700 hover:text-red-900 text-xs font-bold py-2 transition hidden md:inline-block">Logout</a>
                <% } else { %>
                    <a href="/login" class="maroon-btn px-4 py-2 rounded-xl text-xs font-extrabold shadow-sm flex items-center gap-1.5">
                        <span>🔐 Admin</span>
                    </a>
                <% } %>

                <!-- Hamburger Button (Mobile) -->
                <button id="menu-btn" class="md:hidden focus:outline-none text-[#75142c] p-2 rounded-lg hover:bg-slate-100 transition" aria-label="Toggle Menu">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </nav>
    </header>

    <script>
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        if (menuBtn && mobileMenu) {
            menuBtn.addEventListener('click', function(e) {
                e.preventDefault();
                mobileMenu.classList.toggle('hidden');
                mobileMenu.classList.toggle('flex');
            });
        }
    </script>