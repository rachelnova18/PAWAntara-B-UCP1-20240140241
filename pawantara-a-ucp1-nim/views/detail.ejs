<%- include('partials/navbar') %>

<main class="container mx-auto px-4 py-12 flex-grow max-w-2xl text-center">
    <% if (!product) { %>
        <article class="bg-red-50 p-8 rounded-lg shadow text-red-700 border border-red-200">
            <h1 class="text-3xl font-bold mb-4">404 - Produk Tidak Ditemukan</h1>
            <p class="mb-6">Maaf, produk yang Anda cari tidak ada di sistem kami.</p>
            <a href="/produk" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Kembali ke Katalog</a>
        </article>
    <% } else { %>
        <article class="bg-white p-8 rounded-lg shadow border text-left">
            <h1 class="text-3xl font-bold mb-2"><%= product.name %></h1>
            <span class="inline-block bg-blue-100 text-blue-800 text-sm px-2 py-1 rounded mb-4"><%= product.category %></span>
            
            <p class="text-2xl text-blue-600 font-semibold mb-2">Rp <%= product.price.toLocaleString('id-ID') %></p>
            <p class="text-gray-700 mb-6">Sisa stok saat ini: <strong><%= product.stock %> item</strong></p>
            
            <a href="/produk" class="text-blue-600 underline hover:text-blue-800">&larr; Kembali</a>
        </article>
    <% } %>
</main>

<%- include('partials/footer') %>