<%- include('partials/navbar') %>

<main class="container mx-auto px-4 py-10 flex-grow max-w-4xl">
    <% if (!product) { %>
        <!-- Card Produk Tidak Ditemukan -->
        <article class="maroon-card p-10 rounded-3xl text-center max-w-lg mx-auto shadow-sm">
            <div class="w-20 h-20 bg-rose-100 text-[#75142c] rounded-full flex items-center justify-center text-3xl font-bold mx-auto mb-4 border border-rose-200">
                ⚠️
            </div>
            <h1 class="text-2xl font-black text-slate-800 mb-2">Produk Tidak Ditemukan</h1>
            <p class="text-slate-500 text-sm mb-6">Maaf, produk sembako yang Anda cari tidak tersedia atau telah dihapus dari inventaris toko.</p>
            <a href="/produk" class="inline-block maroon-btn font-extrabold px-6 py-3 rounded-xl text-sm shadow-sm">
                &larr; Kembali ke Katalog Sembako
            </a>
        </article>
    <% } else { %>
        <!-- Breadcrumb & Back Link -->
        <div class="mb-6 flex items-center gap-2 text-xs text-slate-500 font-medium">
            <a href="/produk" class="hover:text-[#75142c] transition">&larr; Kembali ke Katalog</a>
            <span>/</span>
            <span class="text-[#75142c] font-semibold capitalize"><%= product.category %></span>
            <span>/</span>
            <span class="text-slate-400"><%= product.name %></span>
        </div>

        <!-- Detail Product Card Maroon -->
        <article class="maroon-card rounded-3xl p-6 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            
            <!-- Kolom Gambar -->
            <div class="relative rounded-2xl overflow-hidden bg-slate-50 aspect-square max-h-[350px] border border-slate-100">
                <% if (product.badge) { %>
                    <span class="absolute top-4 left-4 z-10 maroon-badge text-xs font-bold px-3 py-1 rounded-lg uppercase tracking-wider shadow-xs">
                        <%= product.badge %>
                    </span>
                <% } %>
                <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover">
            </div>

            <!-- Kolom Info Produk -->
            <div class="flex flex-col h-full justify-between">
                <div>
                    <span class="inline-block maroon-badge-gold text-xs font-extrabold px-3.5 py-1 rounded-full uppercase tracking-wider mb-3">
                        <%= product.category %>
                    </span>
                    <h1 class="text-2xl md:text-3xl font-black text-slate-800 leading-tight mb-3">
                        <%= product.name %>
                    </h1>

                    <div class="mb-6 pb-4 border-b border-slate-100">
                        <p class="text-[10px] text-slate-400 uppercase tracking-wider mb-1">Harga Satuan</p>
                        <p class="text-3xl font-black maroon-gradient-text">
                            Rp <%= product.price.toLocaleString('id-ID') %>
                        </p>
                    </div>

                    <!-- Informasi Stok -->
                    <div class="space-y-3 mb-6">
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-slate-500">Status Ketersediaan:</span>
                            <% if (product.stock > 0) { %>
                                <span class="bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold px-3 py-1 rounded-md flex items-center gap-1.5">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Ready Stock (<%= product.stock %> item)
                                </span>
                            <% } else { %>
                                <span class="bg-rose-50 text-rose-800 border border-rose-200 text-xs font-bold px-3 py-1 rounded-md">
                                    Stok Habis
                                </span>
                            <% } %>
                        </div>
                        <div class="flex items-center justify-between text-sm">
                            <span class="text-slate-500">Jaminan Kualitas:</span>
                            <span class="font-semibold text-slate-800 text-xs">100% Produk Original & Segar</span>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col gap-3 pt-4 border-t border-slate-100">
                    <a href="https://wa.me/?text=Halo%20Ibu%20Aries,%20saya%20mau%20pesan%20<%= encodeURIComponent(product.name) %>" target="_blank" class="w-full maroon-btn font-extrabold py-3.5 rounded-xl text-center text-sm flex items-center justify-center gap-2 shadow-sm">
                        <span>💬 Pesan via WhatsApp</span>
                    </a>
                    <a href="/tanya-ai" class="w-full maroon-btn-secondary font-bold py-3 rounded-xl text-center text-sm flex items-center justify-center gap-2">
                        <span>✨ Tanya Detail ke AI</span>
                    </a>
                </div>
            </div>
        </article>
    <% } %>
</main>

<%- include('partials/footer') %>